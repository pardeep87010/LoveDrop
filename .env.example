# ==============================================================================
# LoveDrop Production Environment Configuration Template
# ==============================================================================

# 1. MongoDB Database Connection (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.gd0esmt.mongodb.net/lovedrop?retryWrites=true&w=majority

# 2. Cloudflare R2 Storage (For photos & persistent media)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://cdn.lovedrop.online

# 3. Image AES-256-GCM Encryption Key (64-character hex string)
IMAGE_ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# 4. Resend Email Delivery
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=LoveDrop <support@lovedrop.online>

# 5. App Base URL
NEXT_PUBLIC_APP_URL=https://lovedrop.online
